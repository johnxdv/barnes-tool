# Coordonnées de l'agence imprimées sur la page « Notre agence » du rapport.
#
# Toutes facultatives : un champ non renseigné s'affiche « Non renseigné » sur
# la page, et reste corrigeable à la main dans le rapport. Renseignez-les pour
# que chaque rapport sorte complet sans intervention.
#
# Copiez ce fichier en `.env` (ignoré par git) ou déclarez ces variables dans
# les réglages du déploiement Vercel. Elles sont lues à la construction du
# bundle : un changement demande une reconstruction.

VITE_AGENCE_ENSEIGNE="Barnes"
VITE_AGENCE_NOM="Barnes Marseille"
VITE_AGENCE_BASELINE="Avis de valeur immobilière"
VITE_AGENCE_ADRESSE=""
VITE_AGENCE_CODE_POSTAL=""
VITE_AGENCE_VILLE=""
VITE_AGENCE_TELEPHONE=""
VITE_AGENCE_EMAIL=""
VITE_AGENCE_SITE=""
VITE_AGENCE_MENTIONS=""

# Le conseiller qui signe le rapport — facultatif, et corrigeable à l'écran
# quand plusieurs négociateurs partagent le même déploiement.
VITE_AGENCE_CONSEILLER=""
VITE_AGENCE_CONSEILLER_TELEPHONE=""
VITE_AGENCE_CONSEILLER_EMAIL=""
